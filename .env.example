NODE_ENV=development
PORT=3000
# Public address of the site, no trailing slash
SITE_URL=http://localhost:3000
# Long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# MongoDB connection string, e.g.
# mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
# Database name inside that cluster (default lovewins)
MONGODB_DB=lovewins
# Optional backup directory (default ./backups)
BACKUP_DIR=
# Flutterwave (leave blank to run donations in demo mode)
FLW_SECRET_KEY=
FLW_WEBHOOK_HASH=
