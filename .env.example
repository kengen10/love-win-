NODE_ENV=development
PORT=3000
# Public address of the site, no trailing slash. It is also the payment callback
# and the address Pesapal calls back (IPN), because this app serves the website
# and the API together.
SITE_URL=http://localhost:3000
# Long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# MongoDB Atlas connection string and database name
MONGODB_URI=
MONGODB_DB=lovewins
# Optional backup directory (default ./backups)
BACKUP_DIR=
# Pesapal (leave the keys blank to switch online giving off gracefully)
# "sandbox" until Pesapal confirms your live account is ready, then "live"
PESAPAL_ENV=sandbox
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
# Optional: reuse an existing IPN id (auto-registered on first payment if empty)
PESAPAL_IPN_ID=
